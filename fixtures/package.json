{
  "name": "@wise-excavate/git-fixtures",
  "version": "0.1.0",
  "type": "module",
  "description": "Build real Git repositories deterministically, for testing Git tooling.",
  "keywords": [
    "git",
    "testing",
    "fixtures",
    "deterministic"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GodoyMS/excavate.git",
    "directory": "fixtures"
  },
  "bugs": {
    "url": "https://github.com/GodoyMS/excavate/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node ../scripts/require-pnpm-publish.mjs"
  }
}
