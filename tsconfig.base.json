{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",

    /* Project references: every package is composite so `tsc -b` builds the
       dependency graph in order and fails on a cycle. This is half of the
       fitness function for ADR-0001; scripts/check-deps.mjs is the other half. */
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    /* `erasableSyntaxOnly` keeps every source file runnable under Node's
       type-stripping loader: no enums, no parameter properties, no namespaces. */
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
