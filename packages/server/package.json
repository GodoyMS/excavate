{
  "name": "@wise-excavate/server",
  "version": "0.1.0",
  "type": "module",
  "description": "The Excavate daemon: sessions, SSE progress, and the report API.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@wise-excavate/ai": "workspace:*",
    "@wise-excavate/analysis": "workspace:*",
    "@wise-excavate/core": "workspace:*",
    "@wise-excavate/evidence": "workspace:*",
    "@wise-excavate/git": "workspace:*",
    "@wise-excavate/index": "workspace:*",
    "@wise-excavate/store": "workspace:*",
    "@hono/node-server": "^2.1.0",
    "hono": "^4.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GodoyMS/excavate.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/GodoyMS/excavate/issues"
  },
  "homepage": "https://github.com/GodoyMS/excavate#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "git",
    "git-history",
    "code-archaeology",
    "hotspots",
    "code-ownership",
    "bus-factor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "node ../../scripts/require-pnpm-publish.mjs"
  }
}
