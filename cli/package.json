{
  "name": "wise-excavate",
  "version": "0.1.0",
  "type": "module",
  "description": "Git history archaeology in your terminal. Hotspots, knowledge islands, and why a line exists.",
  "license": "Apache-2.0",
  "bin": {
    "excavate": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@wise-excavate/core": "workspace:*",
    "@wise-excavate/server": "workspace:*",
    "@wise-excavate/ui": "workspace:*",
    "commander": "^15.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GodoyMS/excavate.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/GodoyMS/excavate/issues"
  },
  "homepage": "https://github.com/GodoyMS/excavate#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "git",
    "git-history",
    "code-archaeology",
    "hotspots",
    "code-ownership",
    "bus-factor"
  ]
}
